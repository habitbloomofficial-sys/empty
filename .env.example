# Everything below is optional: you can paste all of these into the app's
# Settings panel instead (gear icon, top right), which saves them to
# data/settings.json and applies them without restarting the server.
# Values saved there take precedence over anything set here.

# --- Axis's brain — set ONE of these two providers ---

# Option A: OpenAI
# --- Claude (Anthropic) -----------------------------------------------------
# The strongest brain, and paid per use rather than free. Leave the model unset
# for Claude Opus 5; claude-haiku-4-5 is cheaper and quicker. Effort is how hard
# he thinks before answering: low by default, since thinking is silence.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_EFFORT=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Option B: Gemini (get a free key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Leave blank to track Google's current Flash model. If a pinned model is
# retired, Axis follows the replacement Google names in the 404.
GEMINI_MODEL=

# Option C: OpenRouter — one key for most frontier models (openrouter.ai/keys).
# Leave the model blank and pick it in Settings; that list is fetched live from
# your own account, so it is never out of date.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# If several keys above are set, force one explicitly with
# AI_PROVIDER=openai, gemini, or openrouter.
AI_PROVIDER=

# --- Voice replies, and speech-to-text for the microphone ---
ELEVENLABS_API_KEY=
# Optional: a specific ElevenLabs voice id (defaults to "Adam"). Easier to set
# in Settings, which lists your account's voices and can play one back before
# you commit to it. A Voice Library voice must be added to My Voices first.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# --- Optional: Gmail integration (see README for setup) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback

# --- Optional: WhatsApp integration via Twilio (see README for setup) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO_DEFAULT=

# --- Optional: YouTube channel statistics (see README for setup) ---
# Needs "YouTube Data API v3" enabled on the key's Google project. Leave the key
# blank to try GEMINI_API_KEY instead — same kind of key, different API.
YOUTUBE_API_KEY=
# Your channel: an @handle, a channel URL, or a UC… channel id.
YOUTUBE_CHANNEL=

# --- Optional: extra folders Axis may search ---
# Desktop, Documents, Downloads, Pictures, Videos and Music are searched
# already. Add anything else here, as full paths separated by semicolons.
FILE_SEARCH_ROOTS=

# --- Optional: phone calls via Twilio Voice (see README) ---
# A Twilio number with Voice enabled. Uses the same SID/token as WhatsApp.
TWILIO_VOICE_FROM=
# The phone that rings. Nothing is dialled until you answer it.
MY_PHONE_NUMBER=
# Assumed for numbers said without one, e.g. 45 for Denmark.
PHONE_COUNTRY_CODE=
# One per line (or separated by semicolons): name = number
PHONE_CONTACTS=

# --- Optional: Zapier automations (see README) ---
# One per line: Name = https://hooks.zapier.com/hooks/catch/XXXXX/YYYYY/
# Make the Zap with a "Webhooks by Zapier - Catch Hook" trigger; Axis fires it
# by the name you give it here, never by a URL from anywhere else.
# --- Web search (optional) -------------------------------------------------
# Searching already works through whichever brain you run: OpenRouter searches
# with its own key (a little credit per search), Gemini with its own (free
# tier). These two are only for searching through your own Programmable Search
# Engine instead, which takes precedence when set.
# Leave the key empty to reuse YOUTUBE_API_KEY (needs the Custom Search API on).
GOOGLE_SEARCH_CX=
GOOGLE_SEARCH_KEY=

ZAPIER_HOOKS=

# --- Optional: where written documents go ---
# Defaults to Documents\Axis in your home folder.
DOCUMENTS_FOLDER=

# --- Optional: personality ---
# What he calls you. Default "sir"; anything short works.
USER_TITLE=
# dry (default) | playful | off
HUMOUR=

# --- Optional: speed tuning ---
# How hard Gemini thinks before replying: none (default) | low | medium | high.
# Thinking happens before any words appear, so it is silence you wait through.
GEMINI_REASONING_EFFORT=
# Set to "off" to stop Axis opening apps and websites on this machine.
# Which browser Axis opens pages in: auto, chrome, edge, firefox, opera, brave.
BROWSER=

# Video generation. Off unless this says "on" - it costs $1-3 per video, every
# time, on a Gemini key with billing enabled. VEO_MODEL pins a model; left
# empty, Axis picks the cheapest one the key can use.
VIDEO_GENERATION=
VEO_MODEL=

DESKTOP_CONTROL=
# Ceiling on reply length, in tokens (default 2000). Mostly matters on
# OpenRouter, which refuses a request your balance couldn't cover.
MAX_TOKENS=

# --- Remote access ----------------------------------------------------------
# There is no key for this. The passcode is set in Settings, hashed, and stored
# in data/auth.json - never in this file and never sent to the browser.
