# --- Required: JARVIS's brain ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Required for voice replies ---
ELEVENLABS_API_KEY=
# Optional: pick a specific ElevenLabs voice id (defaults to "Adam")
