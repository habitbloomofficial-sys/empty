# Everything below is optional: you can paste all of these into the app's
# Settings panel instead (gear icon, top right), which saves them to
# data/settings.json and applies them without restarting the server.
# Values saved there take precedence over anything set here.

# --- JARVIS's brain — set ONE of these two providers ---

# Option A: OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Option B: Gemini (get a free key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Leave blank to track Google's current Flash model. If a pinned model is
# retired, JARVIS follows the replacement Google names in the 404.
GEMINI_MODEL=

# Option C: OpenRouter — one key for most frontier models (openrouter.ai/keys).
# Leave the model blank and pick it in Settings; that list is fetched live from
# your own account, so it is never out of date.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# If several keys above are set, force one explicitly with
# AI_PROVIDER=openai, gemini, or openrouter.
AI_PROVIDER=

# --- Voice replies, and speech-to-text for the microphone ---
ELEVENLABS_API_KEY=
# Optional: pick a specific ElevenLabs voice id (defaults to "Adam")
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# --- Optional: Gmail integration (see README for setup) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback

# --- Optional: WhatsApp integration via Twilio (see README for setup) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO_DEFAULT=

# --- Optional: speed tuning ---
# How hard Gemini thinks before replying: none (default) | low | medium | high.
# Thinking happens before any words appear, so it is silence you wait through.
GEMINI_REASONING_EFFORT=
# Set to "off" to stop JARVIS opening apps and websites on this machine.
DESKTOP_CONTROL=
